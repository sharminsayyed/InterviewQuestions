@{
    ViewData["Title"] = "Home Page";
}
@model List<Employee>

<table>
    <tr>
        <th>EmployeeId</th>
        <th>Name</th>
        <th>Position</th>
        <th>Salary</th>
        <th>Email</th>
    </tr>
    @foreach(var emp in Model)
    {
        <tr>
            <td>@emp.Id</td>
            <td>@emp.Name</td>
            <td>@emp.Position</td>
            <td>@emp.Salary</td>
            <td>@emp.email</td>
        </tr>
    }
</table>

